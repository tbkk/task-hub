# 复制到仓库根 .env.local；只支持 KEY=VALUE，可用成对引号，不执行变量替换。
# 已导出的同名环境变量优先。不要把密码、验证码或秘密提交到仓库。
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=task_hub_demo_test
MYSQL_USER=root
MYSQL_PASSWORD=
TASKHUB_AUTH_MOCK_WECHAT_CODE=
TASKHUB_AUTH_MOCK_WECHAT_OPENID=
TASKHUB_DEPLOY_ADMIN_PORT=18090
TASKHUB_DEPLOY_H5_PORT=18091
TASKHUB_DEPLOY_SERVER_PORT=18092
# 可选：TASKHUB_DEPLOY_RUNTIME、TASKHUB_DEPLOY_NGINX_BIN、TASKHUB_DEPLOY_MIME_TYPES
