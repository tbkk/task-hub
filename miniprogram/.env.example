# H5 development uses the Vite proxy. For WeChat, set a full HTTPS URL including /api.
VITE_API_BASE_URL=/api
VITE_API_PROXY_TARGET=http://localhost:8080
VITE_API_TIMEOUT=10000
# 仅本地基础演示可显式开启，默认使用真实 API 与后端 local/test provider。
VITE_AUTH_MOCK=false
# VITE_AUTH_MOCK=true 时必须按本地演示配置填写，不由认证 API 返回。
VITE_AUTH_MOCK_CODE=123456
